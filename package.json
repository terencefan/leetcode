{
  "dependencies": {
    "hackmyresume": "^1.9.0-beta",
    "jsonresume-theme-kendall": "^0.2.0",
    "jsonresume-theme-lucide": "^1.1.0",
    "jsonresume-theme-macchiato": "^1.1.0",
    "jsonresume-theme-rickosborne": "^2022.9.16-T1450",
    "jsonresume-theme-stackoverflow": "^2.1.0",
    "markdown-pdf": "^11.0.0",
    "md-to-pdf": "^5.2.4"
  },
  "scripts": {
    "resume": "md-to-pdf FANTENGYUAN-enUS.md && md-to-pdf FANTENGYUAN-zhCN.md",
    "build": "hackmyresume build resume-zhCN.json -t node_modules/jsonresume-theme-onepage-plus to out/范腾远.pdf",
    "build-en": "hackmyresume build resume-enUS.json -t node_modules/jsonresume-theme-onepage-plus to out/FANTENGYUAN.pdf"
  }
}
